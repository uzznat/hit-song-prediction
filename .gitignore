# ============================================================
#  Raw data — NOT redistributed (≈25 GB). See docs/DATA.md for
#  the download links and where each file must be placed.
# ============================================================

# ISMIR 2019 / Zenodo 3258042 (msd_audio_features.tar.gz, ~18 GB extracted)
features_tracks_*/
msd_bb_matches.csv
msd_bb_non_matches.csv

# Kaggle — The Spotify Hit Predictor Dataset (1960-2019)
The-Spotify-Hit-Predictor-Dataset/*.csv

# SpotGenTrack / DeepHits (Stanford)
SpotGenTrack/
spotify_tracks.csv
spotify_albums.csv
spotify_artists.csv
low_level_audio_features.csv
lyrics_features.csv

# Billboard / Hot 100 helper tables
hot100.csv
billboard_24years_lyrics_spotify.csv

# Derived caches (regenerated by the scripts; audio clips + pickles)
cache/
ext_cache/
__pycache__/
*.pyc

# LaTeX build artifacts
paper/*.aux
paper/*.log
paper/*.out
paper/*.blg
paper/*.synctex.gz

# Release bundles built with `git archive`
*.zip
