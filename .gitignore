# ============================================================
#  Raw data — NOT redistributed (≈25 GB). See docs/DATA.md for
#  the download links and where each file must be placed.
# ============================================================

# Every raw dataset lives in data/ (Kaggle decade files, Hot 100 history,
# ISMIR 2019 CSVs + features_tracks_a..z, SpotGenTrack, Billboard year-end)
data/

# Derived caches (regenerated by the scripts; audio clips + pickles)
cache/
ext_cache/
__pycache__/
*.pyc

# LaTeX build artifacts
paper/*.aux
paper/*.log
paper/*.out
paper/*.blg
paper/*.synctex.gz

# Release bundles built with `git archive`
releases/
*.zip

# Operational logs of the Deezer download/extract runs
paper_results/logs/fetch/
